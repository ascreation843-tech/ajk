{
  "version": 2,
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 25
    }
  }
}
